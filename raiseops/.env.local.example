# ─── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── AI Foundry (Primary — recommended) ────────────────────────────────────
# Supports Azure AI Foundry, GitHub AI Models, or any OpenAI-compatible endpoint.
# Get an Azure AI Foundry key at: https://ai.azure.com
# Or use GitHub Models (free tier): https://github.com/marketplace/models
AI_FOUNDRY_API_KEY=your_ai_foundry_api_key
AI_FOUNDRY_MODEL=gpt-4o-mini
AI_FOUNDRY_BASE_URL=https://models.inference.ai.azure.com

# Optional AI Foundry settings
# AI_FOUNDRY_TEMPERATURE=0.7

# ─── Anthropic Claude (Fallback — if AI Foundry is not set) ───────────────
# Used when AI_FOUNDRY_API_KEY is not configured.
# Get your key at: https://console.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_api_key
# LLM_MODEL=claude-haiku-4-5-20251001   # or claude-sonnet-4-6 for higher quality
